{
  "name": "event-storage-http",
  "version": "1.3.2",
  "type": "module",
  "description": "HTTP API layer for node-event-storage",
  "keywords": [
    "event-storage",
    "event-sourcing",
    "eventstore",
    "http",
    "ndjson"
  ],
  "homepage": "https://github.com/albe/node-event-storage-http",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albe/node-event-storage-http.git"
  },
  "bugs": {
    "url": "https://github.com/albe/node-event-storage-http/issues"
  },
  "files": [
    "src/**/*.js",
    "index.d.ts",
    "README.md"
  ],
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "bench:http": "node ./bench/bench-http-layer.js",
    "bench:http:write": "node ./bench/bench-http-layer.js write",
    "test": "node --test ./test/*.test.js"
  },
  "engines": {
    "node": ">=18.0"
  },
  "license": "MIT",
  "maintainers": [
    {
      "name": "Alexander Berl",
      "email": "a.berl@outlook.com"
    }
  ],
  "peerDependencies": {
    "event-storage": ">=1.3.1"
  },
  "devDependencies": {
    "event-storage": "^1.3.1"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
