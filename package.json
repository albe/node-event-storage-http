{
  "name": "event-storage-http",
  "version": "1.3.3",
  "type": "module",
  "description": "HTTP API layer for node-event-storage",
  "keywords": [
    "event-storage",
    "event-sourcing",
    "eventstore",
    "http",
    "ndjson"
  ],
  "homepage": "https://github.com/albe/node-event-storage-http",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albe/node-event-storage-http.git"
  },
  "bugs": {
    "url": "https://github.com/albe/node-event-storage-http/issues"
  },
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "README.md"
  ],
  "types": "./src/server/index.d.ts",
  "exports": {
    "./protocol": {
      "types": "./src/protocol/index.d.ts",
      "default": "./src/protocol/index.js"
    },
    "./client": {
      "types": "./src/client/index.d.ts",
      "default": "./src/client/index.js"
    },
    ".": {
      "types": "./src/server/index.d.ts",
      "default": "./src/server/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "bench:http": "node ./bench/bench-http-layer.js",
    "bench:http:write": "node ./bench/bench-http-layer.js write",
    "test": "node --test ./test/*.test.js",
    "test:imports": "node ./scripts/check-imports.mjs"
  },
  "engines": {
    "node": ">=20.0"
  },
  "license": "MIT",
  "maintainers": [
    {
      "name": "Alexander Berl",
      "email": "a.berl@outlook.com"
    }
  ],
  "peerDependencies": {
    "event-storage": ">=1.3.4",
    "express": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "event-storage": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "event-storage": "^1.3.4",
    "express": "^5.2.1"
  }
}
